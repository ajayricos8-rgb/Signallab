# Server-only OpenRouter secret. Never use VITE_OPENROUTER_API_KEY.
# Copy this file to .env in this directory, or configure your deployment's secrets.
OPENROUTER_API_KEY=
# Optional: override OpenRouter base URL (default https://openrouter.ai/api/v1) — useful for proxies/mocks in restricted sandboxes
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: site URL for OpenRouter rankings / attribution (sent as HTTP-Referer + X-Title)
# OPENROUTER_HTTP_REFERER=https://your-app.example.com
# OPENROUTER_SITE_URL is legacy alias for HTTP_REFERER
PORT=8080
