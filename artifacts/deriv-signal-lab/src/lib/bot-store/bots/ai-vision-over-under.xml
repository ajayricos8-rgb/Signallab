<!--
  AI Vision — Over/Under
  ======================

  An Over/Under bot that prices the market itself. The tick block reads the
  market once per tick, and the trade options and the purchase conditions all
  read that same decision, so the barrier, the stake and the entry can never
  come from different moments. Every tick it:

    1. forecasts the ten last digits at the moment the contract expires, with
       seven models (long-run and recent digit frequency, the digit transition
       table, a kernel replay of similar states, an analytical price forecast, a
       fair-odds anchor and an online-trained neural net);
    2. reads what Deriv actually pays for every barrier on this symbol and
       duration, straight from the proposal API;
    3. picks the barrier and the side with the strongest measured lean, gives up
       when the lean is inside the noise, and sizes the stake by how strong the
       lean is and how much the models agree;
    4. learns from the settled digit — every contract scores each model and
       takes one gradient step, per market, and the brain survives restarts.

  Set the knobs in the "Run once at start" block. Open the journal to watch the
  reasoning: every entry says which contract, the measured lean in points and
  standard deviations, the payout, the expected value and the confidence.

  Read this before running it for real
  Digit contracts carry an exchange margin (the payout is below fair odds, and
  long-shot barriers are taxed hardest). No model can measure its way past a
  margin that large on demand, so this bot does not pretend to: it trades the
  strongest measured leans and prints the true expected value on every entry,
  which is usually negative. Raise "ai min edge" to 0 or more to switch on the
  strict gate that refuses any trade which does not beat the margin — the bot
  will then sit still for long stretches, and that is the honest answer on a
  market with no measurable edge. Start on a demo account, keep the loss limit
  small, and never raise the stake to chase a loss.
-->
<xml xmlns="http://www.w3.org/1999/xhtml" collection="false" is_dbot="true">
  <variables>
    <variable type="" id="aiVar01">ai base stake</variable>
    <variable type="" id="aiVar02">ai duration</variable>
    <variable type="" id="aiVar03">ai min edge</variable>
    <variable type="" id="aiVar04">ai min lean</variable>
    <variable type="" id="aiVar05">ai min confidence</variable>
    <variable type="" id="aiVar06">ai agreement</variable>
    <variable type="" id="aiVar07">ai risk</variable>
    <variable type="" id="aiVar08">ai loss limit</variable>
    <variable type="" id="aiVar09">ai profit target</variable>
    <variable type="" id="aiVar10">ai cooldown</variable>
    <variable type="" id="aiVar11">ai stake percent</variable>
    <variable type="" id="aiVar12">ai contracts</variable>
  </variables>
  <block type="trade_definition" id="aiTrade01" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="aiMarket01" deletable="false" movable="false">
        <field name="MARKET_LIST">volidx</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_100</field>
        <next>
          <block type="trade_definition_tradetype" id="aiType01" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="aiContract01" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="aiCandle01" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="aiRestart01" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="aiError01" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="s013"><field name="VAR" id="aiVar01">ai base stake</field><value name="VALUE"><shadow type="math_number" id="n001"><field name="NUM">1</field></shadow></value><next><block type="variables_set" id="s014"><field name="VAR" id="aiVar02">ai duration</field><value name="VALUE"><shadow type="math_number" id="n002"><field name="NUM">5</field></shadow></value><next><block type="variables_set" id="s015"><field name="VAR" id="aiVar03">ai min edge</field><value name="VALUE"><shadow type="math_number" id="n003"><field name="NUM">-100</field></shadow></value><next><block type="variables_set" id="s016"><field name="VAR" id="aiVar04">ai min lean</field><value name="VALUE"><shadow type="math_number" id="n004"><field name="NUM">1.6</field></shadow></value><next><block type="variables_set" id="s017"><field name="VAR" id="aiVar05">ai min confidence</field><value name="VALUE"><shadow type="math_number" id="n005"><field name="NUM">55</field></shadow></value><next><block type="variables_set" id="s018"><field name="VAR" id="aiVar06">ai agreement</field><value name="VALUE"><shadow type="math_number" id="n006"><field name="NUM">0.7</field></shadow></value><next><block type="variables_set" id="s019"><field name="VAR" id="aiVar07">ai risk</field><value name="VALUE"><shadow type="math_number" id="n007"><field name="NUM">0.6</field></shadow></value><next><block type="variables_set" id="s020"><field name="VAR" id="aiVar08">ai loss limit</field><value name="VALUE"><shadow type="math_number" id="n008"><field name="NUM">30</field></shadow></value><next><block type="variables_set" id="s021"><field name="VAR" id="aiVar09">ai profit target</field><value name="VALUE"><shadow type="math_number" id="n009"><field name="NUM">50</field></shadow></value><next><block type="variables_set" id="s022"><field name="VAR" id="aiVar10">ai cooldown</field><value name="VALUE"><shadow type="math_number" id="n010"><field name="NUM">3</field></shadow></value><next><block type="variables_set" id="s023"><field name="VAR" id="aiVar11">ai stake percent</field><value name="VALUE"><shadow type="math_number" id="n011"><field name="NUM">2</field></shadow></value><next><block type="variables_set" id="s024"><field name="VAR" id="aiVar12">ai contracts</field><value name="VALUE"><shadow type="math_number" id="n012"><field name="NUM">0</field></shadow></value><next><block type="notify" id="no025">
  <field name="NOTIFICATION_TYPE">success</field>
  <field name="NOTIFICATION_SOUND">silent</field>
  <value name="MESSAGE"><block type="text" id="t026"><field name="TEXT">AI Vision Over/Under armed — tuning is in the Run once at start block</field></block></value>
</block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="aiOptions01">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION"><block type="variables_get" id="g027"><field name="VAR" id="aiVar02">ai duration</field></block></value>
        <value name="AMOUNT">
          <block type="r_safe_stake" id="aiSafe01">
            <value name="STAKE">
              <block type="vision_stake" id="aiStake01">
                <value name="BASE"><block type="variables_get" id="g028"><field name="VAR" id="aiVar01">ai base stake</field></block></value>
              </block>
            </value>
            <value name="PERCENT"><block type="variables_get" id="g029"><field name="VAR" id="aiVar11">ai stake percent</field></block></value>
          </block>
        </value>
        <value name="PREDICTION">
          <block type="vision_barrier" id="aiBarrier01"></block>
        </value>
        <field name="AMOUNT_LIMITS"></field>
      </block>
    </statement>
  </block>
  <block type="tick_analysis" id="aiTick01" x="0" y="1500">
    <statement name="TICKANALYSIS_STACK">
      <block type="vision_analyse" id="aiAnalyse01">
  <value name="HORIZON"><block type="variables_get" id="g050"><field name="VAR" id="aiVar02">ai duration</field></block></value>
  <value name="MIN_EDGE"><block type="variables_get" id="g051"><field name="VAR" id="aiVar03">ai min edge</field></block></value>
  <value name="MIN_LEAN"><block type="variables_get" id="g052"><field name="VAR" id="aiVar04">ai min lean</field></block></value>
  <value name="MIN_CONFIDENCE"><block type="variables_get" id="g053"><field name="VAR" id="aiVar05">ai min confidence</field></block></value>
  <value name="AGREEMENT"><block type="variables_get" id="g054"><field name="VAR" id="aiVar06">ai agreement</field></block></value>
  <value name="RISK"><block type="variables_get" id="g055"><field name="VAR" id="aiVar07">ai risk</field></block></value>
</block>
    </statement>
  </block>
  <block type="before_purchase" id="aiBefore01" x="0" y="760">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="aiEntryIf01">
  <value name="IF0"><block type="logic_operation" id="l038"><field name="OP">AND</field><value name="A"><block type="vision_go" id="aiGo01"></block></value><value name="B"><block type="logic_operation" id="l037"><field name="OP">AND</field><value name="A"><block type="r_loss_guard" id="r030"><value name="LIMIT"><block type="variables_get" id="g031"><field name="VAR" id="aiVar08">ai loss limit</field></block></value></block></value><value name="B"><block type="logic_operation" id="l036"><field name="OP">AND</field><value name="A"><block type="r_profit_guard" id="r032"><value name="TARGET"><block type="variables_get" id="g033"><field name="VAR" id="aiVar09">ai profit target</field></block></value></block></value><value name="B"><block type="r_cooldown" id="r034"><value name="SECONDS"><block type="variables_get" id="g035"><field name="VAR" id="aiVar10">ai cooldown</field></block></value></block></value></block></value></block></value></block></value>
  <statement name="DO0"><block type="variables_set" id="s049"><field name="VAR" id="aiVar12">ai contracts</field><value name="VALUE"><block type="math_arithmetic" id="m046"><field name="OP">ADD</field><value name="A"><block type="variables_get" id="g047"><field name="VAR" id="aiVar12">ai contracts</field></block></value><value name="B"><shadow type="math_number" id="n048"><field name="NUM">1</field></shadow></value></block></value><next><block type="controls_if" id="aiDirIf01">
  <mutation else="1"></mutation>
  <value name="IF0">
    <block type="logic_compare" id="aiCmp01">
      <field name="OP">EQ</field>
      <value name="A"><block type="vision_direction" id="aiDir01"></block></value>
      <value name="B"><block type="text" id="t045"><field name="TEXT">over</field></block></value>
    </block>
  </value>
  <statement name="DO0"><block type="notify" id="no039"><field name="NOTIFICATION_TYPE">success</field><field name="NOTIFICATION_SOUND">silent</field><value name="MESSAGE"><block type="vision_summary" id="vs040"></block></value><next><block type="purchase" id="pu041"><field name="PURCHASE_LIST">DIGITOVER</field></block></next></block></statement>
  <statement name="ELSE"><block type="notify" id="no042"><field name="NOTIFICATION_TYPE">info</field><field name="NOTIFICATION_SOUND">silent</field><value name="MESSAGE"><block type="vision_summary" id="vs043"></block></value><next><block type="purchase" id="pu044"><field name="PURCHASE_LIST">DIGITUNDER</field></block></next></block></statement>
</block></next></block></statement>
</block>
    </statement>
  </block>
  <block type="after_purchase" id="aiAfter01" x="760" y="760">
    <statement name="AFTERPURCHASE_STACK">
      <block type="vision_learn" id="aiLearn01"><value name="DIGIT"><shadow type="math_number" id="n056"><field name="NUM">-1</field></shadow></value><next><block type="controls_if" id="aiAgainIf01">
  <mutation else="1"></mutation>
  <value name="IF0"><block type="logic_operation" id="l063"><field name="OP">AND</field><value name="A"><block type="r_loss_guard" id="r059"><value name="LIMIT"><block type="variables_get" id="g060"><field name="VAR" id="aiVar08">ai loss limit</field></block></value></block></value><value name="B"><block type="r_profit_guard" id="r061"><value name="TARGET"><block type="variables_get" id="g062"><field name="VAR" id="aiVar09">ai profit target</field></block></value></block></value></block></value>
  <statement name="DO0"><block type="trade_again" id="ta064"></block></statement>
  <statement name="ELSE"><block type="notify" id="no057">
  <field name="NOTIFICATION_TYPE">warn</field>
  <field name="NOTIFICATION_SOUND">silent</field>
  <value name="MESSAGE"><block type="text" id="t058"><field name="TEXT">AI Vision stopped — profit target or loss limit reached. Open contracts still settle.</field></block></value>
</block></statement>
</block></next></block>
    </statement>
  </block>
  <block type="during_purchase" id="aiDuring01" x="1520" y="0">
    <statement name="DURING_PURCHASE_STACK"></statement>
  </block>
</xml>
