{
  "name": "signallab",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist"
  },
  "build": {
    "command": "if [ -f vite.config.ts ]; then npm install --no-audit --no-fund --package-lock=false && npm run build && node scripts/copy-dist.mjs artifacts/deriv-signal-lab/dist; else npm --prefix ../.. install --no-audit --no-fund --package-lock=false && npm --prefix ../.. run build && node ../../scripts/copy-dist.mjs ./dist; fi"
  },
  "previews": {},
  "observability": {
    "enabled": true
  }
}
