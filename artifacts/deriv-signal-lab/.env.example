# Public Deriv application ID used to identify this client.
#
# It is read-only at runtime and travels in two places:
#   * the market-data WebSocket URL:
#     wss://api.derivws.com/trading/v1/options/ws/public?app_id=...
#   * the `Deriv-App-ID` header on Deriv's Options REST calls when a user
#     connects a Personal Access Token (PAT):
#     GET  /trading/v1/options/accounts
#     POST /trading/v1/options/accounts/{accountId}/otp
#
# This is not an account token and never authenticates an account by itself.
# If unset, the client falls back to Deriv's public test app ID 1089.
VITE_DERIV_APP_ID=
