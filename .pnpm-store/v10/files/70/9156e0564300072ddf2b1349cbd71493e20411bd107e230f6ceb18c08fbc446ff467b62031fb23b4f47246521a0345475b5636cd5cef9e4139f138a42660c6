{
  "name": "@rspack/lite-tapable",
  "version": "1.1.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/rstackjs/rspack-lite-tapable"
  },
  "license": "MIT",
  "description": "Lite weight tapable for Rspack",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint:write"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@rslint/core": "^0.7.0",
    "@rspack/core": "^2.1.4",
    "@rstest/core": "0.11.2",
    "@types/node": "^24.13.3",
    "prettier": "^3.9.5",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rslib",
    "dev": "rslib -w",
    "lint": "rslint && prettier -c .",
    "lint:write": "rslint --fix && prettier -w .",
    "test": "rstest",
    "bump": "pnpx bumpp"
  }
}