# Cloudflare serves this file from the root of the deployed assets.
#
# Navigation HTML and every non-fingerprinted public file must be fetched again
# after a deployment. Vite gives files below /assets a content hash, so that
# narrow rule can safely use a long immutable cache lifetime instead.

/*
  Cache-Control: no-store, no-cache, must-revalidate

/index.html
  X-Content-Type-Options: nosniff

/assets/*
  Cache-Control: public, max-age=31536000, immutable
