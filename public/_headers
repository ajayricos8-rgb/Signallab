# Cloudflare serves this file from the root of the deployed assets.
#
# Vite fingerprints everything under /assets, so those files can be cached for
# a year; index.html must not be, or a new deployment would keep handing clients
# the previous bundle and none of the app's changes would appear.

/index.html
  Cache-Control: no-store, no-cache, must-revalidate
  X-Content-Type-Options: nosniff

/
  Cache-Control: no-store, no-cache, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
